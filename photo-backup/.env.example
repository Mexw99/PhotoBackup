GEMINI_API_KEYS=ใส่คีย์ที่1,ใส่คีย์ที่2,ใส่คีย์ที่3,ใส่คีย์ที่4
PHOTO_BACKUP_AI_MODEL=gemini-3.5-flash

# Optional: ใช้คีย์เดี่ยวได้ แต่ระบบจะรวมกับ GEMINI_API_KEYS และตัดคีย์ซ้ำ
GEMINI_API_KEY=

# จำนวน Worker และการ Retry สำหรับงานวิเคราะห์รูป
AI_ANALYSIS_WORKERS=4
AI_MAX_RETRIES=3
AI_ANALYSIS_REQUEST_TIMEOUT_SECONDS=120
AI_ANALYSIS_JOB_TIMEOUT_SECONDS=900
AI_RETRY_BASE_DELAY_MS=1000
