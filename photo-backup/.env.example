# Do not commit real API keys. Create new keys and set them in your shell.
# gemini, openai, ollama, all หรือรายการคั่นด้วย comma เช่น gemini,openai
AI_PROVIDER=blip
AI_ALLOW_CLOUD=false
AI_ALLOW_LOCAL=true
AI_MAX_CONCURRENCY=1
AI_MAX_RETRIES=3
AI_DAILY_LIMIT=0
AI_MIN_INTERVAL_MS=0
GEMINI_API_KEY=
# Optional: use comma- or semicolon-separated keys. Never commit real keys.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
YOLO_ENABLED=true
YOLO_MODEL_PATH=yolo11n.pt
YOLO_PYTHON=
YOLO_SCRIPT=tools/yolo_worker.py
YOLO_WORKER=
BLIP_MODEL_PATH=models/blip-image-captioning-base
BLIP_TRANSLATOR_MODEL_PATH=models/opus-mt-en-mul
BLIP_PYTHON=
BLIP_SCRIPT=tools/caption_worker.py
BLIP_WORKER=
